{
  "manifest_version": 3,
  "name": "Page Title Bar",
  "version": "1.1.0",
  "description": "Displays the page title, request counts, response times, and response sizes in the side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "sidePanel",
    "webRequest",
    "webNavigation",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Page Title Bar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "host_permissions": ["http://*/*", "https://*/*"]
}
