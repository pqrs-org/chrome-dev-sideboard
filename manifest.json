{
  "manifest_version": 3,
  "name": "Dev Sideboard",
  "version": "1.1.0",
  "description": "Page title, network measurements, JSON fetch/XHR inspection, and local/session storage in the side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "sidePanel",
    "webRequest",
    "webNavigation",
    "storage",
    "clipboardWrite",
    "cookies"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Dev Sideboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/capture-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/capture.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
