{
  "manifest_version": 3,
  "name": "Dev Sideboard",
  "version": "1.2.0",
  "description": "Inspect network activity, storage, and cookies in the side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "sidePanel",
    "webRequest",
    "webNavigation",
    "storage",
    "cookies"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Dev Sideboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "minimum_chrome_version": "142",
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page-content-script.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' blob:; connect-src https:"
  }
}
