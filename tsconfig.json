{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "build/src",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
