{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "force",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
